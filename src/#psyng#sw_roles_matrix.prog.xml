     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/SW_ROLES_MATRIX</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Rollenverletzungs-Matrix</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Dieser Report ermittelt die korrekten Rollen aus dem Selektionsbild.</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Danach bestimmt er aus den ausgeführten TAs, die in den Rollen definiert</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>sind, ob eine SOD-Verletz. zum jeweil. Benutzer vorliegt. Die Farben in</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der ALV-Reportliste kennzeichnen die Benutzeraktionen wie folgt:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Rot = TCode ausgeführt; SOD-Verletzung liegt vor</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Grün = TCode nicht ausgeführt&lt;(&gt;;&lt;)&gt; Benutzer hat entsprech. Zugriff</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,keine Farbe = Ben. hat Zugriff; ausgeführt/nicht ausgeführt &lt;(&gt;;&lt;)&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>keine SOD-Verletzung.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Der Report zeigt anhand der Transaktionsarchivdaten die RFC-Destination,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>die Ben.-ID, den vollst. Benutzernamen, das verwendete Terminal/PC, die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Anzahl der Interaktionen, den Datentyp, den TCode und die TA-Beschreib.</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>an. Über einen zusätzlichen Aufriss können zudem die ausgeführ. Schritte</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>in der TA bestimmt werden, um etwaige Verletzungen zu beheben. Außerdem</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ist eine Datums-/Zeiterfassung zu jedem Transaktionsschritt verfügbar.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SELECTION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Nehmen Sie die Auswahl für den Report vor:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Daten:  Zeitraum für Reporting ist konfigurierbar, oder es können</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>feste Werte über Datumstasten mit folgenden Optionen gewählt werden: 1</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Monat, 6 Monate oder 1 Jahr.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,SOD-Matrixversion: Wählen Sie die passende Version für Ihre</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Reporting-Anforderungen aus dem Aktionsmenü aus.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Rolle: Filtern Sie die Berichtsausgabeliste durch Auswahl nur jener</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Rollen, die beim Reporting berücksichtigt werden sollen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Benutzergruppe(n): Bestimmt die zu berücksichtigenden Benutzergruppen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>beim Reportingprozess.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Ben.-ID(s): Bestimmt die Anzahl der Benutzer, für die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>das Reporting erfolgt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;OUTPUT&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Rolle: Kennzeichnet die auf dem Selektionsbild festgelegte Rolle.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,, SOD-Konflikt-ID:  Bezieht sich auf die in der Selektion festgelegte</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SOD-Matrixversion; ist begrenzt auf die Konflikt-IDs, die auf dem</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Dialogfenster.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Beschreibung: Kennzeichnet die definierte Konflikt-ID-Beschreibung.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Funktions-ID: Legt die Funktions-ID für die Geschäftsprozessfunktion</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>fest.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Beschreibung: Bestimmt die beim Anlegen der Funktion definierte</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Beschreibung.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Schweregrad: Kritisch, Hoch, Mittel und Niedrig</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Transaktion: Diese SAP-Transaktion wurde in der Dialogsitzung</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>unter den Konten zum Benutzernamen ausgeführt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
    <item>
     <DOKIL>
      <ID>RE</ID>
