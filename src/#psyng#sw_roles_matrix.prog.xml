      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/SW_ROLES_MATRIX</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00002</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Role Violation Matrix</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>This report will determine the correct set of roles from the selection</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>screen. Then it will choose from the executed transactions defined in</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>these roles if any SOD violation occurred for each user. The ALV report</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>list colors indicated the following user action conditions.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Red  = tcode was executed and in SOD violation</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Green  = tcode not executed&lt;(&gt;,&lt;)&gt; but the user has access to do so</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,No Color = User has access may or may not have been executed&lt;(&gt;,&lt;)&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>but no SOD violation.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Using transactional archive data, the report will display the RFC</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>destination, User ID, full username, Terminal or PC used, number of</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>interactions data type, transaction code, and the transaction</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>description. Additional drill-down can also determine the steps taken</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>within the transaction to resolve potential violations. We also have the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>date and time recordings for each transactional step.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SELECTION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Enter the selection for the report:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Dates:  time range for reporting could be customized or use the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>determined values from the date buttons that provide the options for 1</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Month, 6 Months, or 1 Year date ranges.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,SOD matrix version: pick the version suitable for your reporting</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>needs from the pull-down.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Role: filter the report output list by selecting only these roles to</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>be considered for reporting.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,User Group(s): this will determine which user groups to be considered</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>for the reporting process.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,User ID(s): this will determine the number of users that will be</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>reported on.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;OUTPUT&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Role: indicates the role that was defined from the selection screen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,SOD Conflict ID:  relating the SOD matrix version defined in the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>selection and limited to the conflict IDs indicated in the selection</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>screen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Description: this indicated the defined conflict id description.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Function ID: defines the function ID related to the business</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>processing function.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Description: determines the description defined when this function</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>was created.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>·,,Severity: Critical, High, Medium, and Low</TDLINE>
