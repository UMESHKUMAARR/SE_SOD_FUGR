      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Zentralsystem: Objekt - Y&amp;SW_ADMF; Feld - DISTCON</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Zielsystem: Objekt - Y&amp;SW_CFGST; Feld -ACTVT 02</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FEATURES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Systeme: Systeme, aus denen die Konfiguration gelesen wird und</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>in denen das neue Konfigurationsset veröffentlicht wird.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Alle Systeme in jedem Konfig.-Set komb.:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Markiert: In jedem System wird ein KonfigSet mit allen ausgewählten</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Systemen erstellt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Entmarkiert (Standard): In jedem System wird ein Konfigurationsset nur</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>für das betreffende System erstellt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Transfer Konfig.-Set-Werte: Die im vorherigen Set erfolgten Änderungen</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>werden in das neue Set übernommen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Neues KonfigSet veröffentlichn: Das neu angelegte Set sollte nach seiner</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Erstellung den Status &quot;Vröffntl.&quot; besitzen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Testmodus: nur Ausgabe</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Standardmäß. glob. SOD-Vers.: Std.-SOD-V. DFLT_GLOBAL_VERSION aus Konf.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Remote-SOD-Version: Dient zum Wechseln zu einer anderen Version als der</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>aktuellen standardmäßigen globalen Version.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>BESCHREIBUNG</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Aus letztem veröffentlichten Konfig.-Set kopieren:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Markiert: Die Beschreibung des neuen Sets ist identisch mit jener des</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>zuletzt veröffentlichten Sets des betreffenden Systems.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Entmarkiert: Die Beschreibung des neuen Sets entspricht der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Benutzereingabe im Beschreibungsfeld.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Wenn kein Text gepflegt ist, sollte folgender Fehler ausgegeben werden:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&quot;Beschreibung für Konfigurationsset ist erforderlich&quot;.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Ausgabe</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Übersicht: Zusammengefasste Protokollausgabe pro System.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Detail: Detailausgabe mit OrgWerten und variablen Werten.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
