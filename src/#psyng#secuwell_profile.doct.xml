     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Definition</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>A Profile is simply group of autherization.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Or</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>A Profile can contain one role or more than one role.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Authorizations are assigned using authorisation-profiles in the form of</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>roles, which are entered into the user master record.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Purpose/Use:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Each role must be generated - the generation of the roles give a profile</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>name to the role, which can be automatisch from</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>SAP defined (T-xxxx profiles) or can you self insert.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Note:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>GENERATED PROFILE = While creating a profile (i.e in transaction PFCG</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>you assign various authorization objects as per the reqquirement. based</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>on the various custom authorizations you generate a profile that has all</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the authorizations</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>assigned).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>This generated profile can be directly added to yuser maintenance in</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SU01 or assigned to a role.</TDLINE>
      </TLINE>
     </LINES>
    </item>
