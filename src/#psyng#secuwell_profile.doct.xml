   <DOC>
    <item>
     <DOKIL>
      <ID>TX</ID>
      <OBJECT>/PSYNG/SECUWELL_PROFILE</OBJECT>
      <LANGU>D</LANGU>
      <TYP>E</TYP>
      <VERSION>0001</VERSION>
      <TXTLINES>00018</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/SECUWELL_PROFILE</TDNAME>
      <TDID>TX</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Definition</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Ein Profil ist eine Gruppe aus Berechtigungen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Oder:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Ein Profil kann eine oder mehrere Rollen enthalten.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Berechtigungen werden über Berechtigungsprofile in Form von Rollen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>zugeordnet, die im Benutzerstamm erfasst sind.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Zweck/Verwendung:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Jede Rolle muss generiert werden; bei der Rollengenerierung wird der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Rolle ein Profilname vergeben, der automatisch von SAP definiert</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>sein kann (T-xxxx-Profile) oder von Ihnen selbst eingefügt werden kann.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Hinweis:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Generiertes Profil: Beim Anlegen eines Profils (d.h. in der TA PFCG)</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ordnen Sie verschiedene BerechtObj. nach Bedarf zu. Basierend auf den</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>verschiedenen kundeneig. Berechtigungen generieren Sie ein Profil, denen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>alle Berechtigungen</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>zugeordnet sind.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Das generierte Profil kann direkt der Benutzerpflege in</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SU01 hinzugefügt oder einer Rolle zugeordnet werden.</TDLINE>
      </TLINE>
     </LINES>
    </item>
