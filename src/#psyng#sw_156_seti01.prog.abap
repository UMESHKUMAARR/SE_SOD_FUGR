MODULE user_command_0100 INPUT.
  ok_code = sy-ucomm.
  CASE ok_code.
    WHEN 'BACK'.
      perform exit.
    WHEN 'SAVE'.
      perform save_data.
  ENDCASE.
ENDMODULE.
