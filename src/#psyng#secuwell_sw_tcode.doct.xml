     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/SECUWELL_SW_TCODE</TDNAME>
      <TDID>TX</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00003</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Transaktionscode</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Kombination aus alphanumerischen Zeichen, die einen Code</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>für eine Geschäftsaufgabe bilden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Hinweis: Krit. Berecht. lassen sich mit einer bestimmten Transaktion</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>verknüpfen oder auf alle TAs anwenden. Soll die Berechtigung auf alle</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>TAs angewendet werden, geben Sie in das Feld &quot;Transaktionscode&quot; das</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Zeichen * für die betreffende KB-ID ein.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
