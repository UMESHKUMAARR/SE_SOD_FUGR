     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Transaction code</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>A combination of alphabetical and numerical characters forming a code</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>for a business task.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Note: Critical Authorizations can be tied to one particular transaction</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>or can be applied to all transactions. If the authorization is to be</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>applied to all transactions, fill the Transaction Code field with * for</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>that particular Critical Authorization ID.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
     </LINES>
