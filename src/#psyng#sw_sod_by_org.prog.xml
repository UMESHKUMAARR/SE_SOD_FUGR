    <item>
     <DOKIL>
      <ID>RE</ID>
      <OBJECT>/PSYNG/SW_SOD_BY_ORG</OBJECT>
      <LANGU>E</LANGU>
      <TYP>E</TYP>
      <VERSION>0021</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00050</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/SW_SOD_BY_ORG</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00021</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Copy SOD Matrix by Org Level Field</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>This utility can use the ORG relevant authorization objects in a source</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SOD Version to create a New Version which will have original functions</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>along with functions with placeholder T_Codes and authorization objects</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>with variable elements defined.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>This can be useful when you want to create a separate SOD Conflict for</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>different organizations in the landscape.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Selection Screen</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Various options available in the report:-</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Source SOD Matrix : Specify the SOD Matrix version which will be used to</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>create the new version.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Target SOD Matrix : Specify the SOD Matrix version which will be created</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>from the utility. It can be an existing version or a new version. In</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>case of an existing version utility will ask if you want to overwrite</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the SOD Version, In case of a new version it won&apos;t ask you for</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>confirmation.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Parse SOD Matrix : On clicking this button the utility will check all</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the organizational elements being used in the Source SOD Matrix and</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>check the checkboxes for the same.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Variable Elements Rule Version : Specify the variable element rule</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>version which will be populated with the variable elements based on the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>selection of organizational areas. A rule version should be created from</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the Variable Element Rules maintenance screen before it can be used</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>here.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Variable Element Prefix : Variable elements created for the new version</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>will have the prefix mentioned in this field. This field is not editable</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>and has a predefined value “/PSYNG/$” specified.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Variable Element Groups : Specify the different organization areas that</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>you need to create the SOD Conflicts and Variable Elements for. For</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>example if you are using BUKRS (Company Code) as a differentiator</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>between different organizational areas then specify the different</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Company Codes available or used in your SAP Systems.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PREREQUISITES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Create Variable Element Version using following steps -</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SE&gt;Misc.tab&gt;Configuration&gt;Variable elements in functions tab.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Set parameter DFLT_VAREL_VERSION to Variable Element Version created in</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>above step.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Length of Conflict ID with combination of Variable Element Group cannot</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>exceed 12</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Length of Function ID with combination of Variable Element Group cannot</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>exceed 12</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FEATURES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;SELECTION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;STANDARD_VARIANTS&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;OUTPUT&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;ACTIVITIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>If you run the report for the variable element group as 1000 and 2000</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>The variable element created /PSYNG/$BUKRS_1000 should have the correct</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>value of company code maintained corresponding to variable element group</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>1000 (which was added in step 6). Similarly for /PSYNG/$WERKS_1000 you</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>would maintain the value of the plant which corresponds to the variable</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>group 1000 (which was added in step 6). Do the same for</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>/PSYNG/$BUKRS_2000 and /PSYNG/$WERKS_2000.</TDLINE>
      </TLINE>
     </LINES>
    </item>
   </LONGTEXTS>
