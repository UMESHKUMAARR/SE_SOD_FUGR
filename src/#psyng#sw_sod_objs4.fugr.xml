      <RSIMP>
       <PARAMETER>BNAME</PARAMETER>
       <DBFIELD>USR02-BNAME</DBFIELD>
      </RSIMP>
      <RSIMP>
       <PARAMETER>REM_EXECUTION</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>CHAR01</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>RFCDEST</PARAMETER>
       <DBFIELD>RFCDES-RFCDEST</DBFIELD>
       <OPTIONAL>X</OPTIONAL>
