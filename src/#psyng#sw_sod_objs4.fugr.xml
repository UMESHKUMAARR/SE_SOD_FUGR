     <TABLES>
      <RSTBL>
       <PARAMETER>ROLETCODE</PARAMETER>
       <DBSTRUCT>/PSYNG/USERTCODE</DBSTRUCT>
       <OPTIONAL>X</OPTIONAL>
      </RSTBL>
      <RSTBL>
       <PARAMETER>ROLEPROF</PARAMETER>
       <DBSTRUCT>/PSYNG/USERPROF</DBSTRUCT>
       <OPTIONAL>X</OPTIONAL>
      </RSTBL>
      <RSTBL>
       <PARAMETER>ROLEAUTH</PARAMETER>
       <DBSTRUCT>/PSYNG/USERAUTH</DBSTRUCT>
       <OPTIONAL>X</OPTIONAL>
      </RSTBL>
      <RSTBL>
       <PARAMETER>FUNCTTRAN</PARAMETER>
       <DBSTRUCT>/PSYNG/FUNCTTRAN</DBSTRUCT>
      </RSTBL>
      <RSTBL>
       <PARAMETER>FAOBJ</PARAMETER>
       <DBSTRUCT>/PSYNG/FAOBJ2</DBSTRUCT>
      </RSTBL>
     </TABLES>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>AGR_NAME</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Role Name</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>BNAME</PARAMETER>
       <KIND>P</KIND>
       <STEXT>User name in user master record</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>REM_EXECUTION</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Remote flag (X = remote, &apos; &apos; = local)</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>RFCDEST</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Logical destination (specified in function call)</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ROLETCODE</PARAMETER>
       <KIND>P</KIND>
       <STEXT>User&apos;s Executable Transaction Codes</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ROLEPROF</PARAMETER>
       <KIND>P</KIND>
       <STEXT>User&apos;s profiles</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ROLEAUTH</PARAMETER>
       <KIND>P</KIND>
       <STEXT>User&apos;s Authorization Data</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>FUNCTTRAN</PARAMETER>
       <KIND>P</KIND>
       <STEXT>SW: Functions and Transactions</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>FAOBJ</PARAMETER>
       <KIND>P</KIND>
       <STEXT>SW: SOD Object Definition</STEXT>
      </RSFDO>
     </DOCUMENTATION>
    </item>
