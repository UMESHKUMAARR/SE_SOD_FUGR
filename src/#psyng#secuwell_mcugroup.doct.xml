     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/SECUWELL_MCUGROUP</TDNAME>
      <TDID>TX</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00004</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>BenGruppe</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Definition</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Mit der Zuordnung von SAP-Benutzern zu Benutzergruppen kann die Pflege</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>an verschiedene Benutzeradministratoren verteilt werden. Der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Systemadministrator ordnet dann nur noch jedem Administrator die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Berechtigung zum Anlegen und Ändern von Benutzern in einer Gruppe zu.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Zweck/Verwendung</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>BenGruppe: Hier die SAP-Benutzergruppe, der bereits MitigKontrollen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>zugeordnet sind.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Hinweis: Für die BenGruppe kann eine vorhd. MitigZuordn. geändert werden</TDLINE>
      </TLINE>
     </LINES>
    </item>
