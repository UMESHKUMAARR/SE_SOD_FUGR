     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>User Group</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Definition</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>By assigning SAP users to user groups, the task of user maintenance can</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>be distributed to different user administrators. The system</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>administrator then only assigns each user administrator the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>authorization to create and change users in a group.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Purpose/Use</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>User Group . Here The actual SAP Usergroup  which  mitigation controls</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>already assigned.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Note:We can Change an Existing Mitigation Assignment for this User Group</TDLINE>
      </TLINE>
     </LINES>
    </item>
