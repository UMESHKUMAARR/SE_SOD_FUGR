      <TDNAME>/PSYNG/SW_124</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>SOD-Version - Matrixübersicht</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Hiermit werden die Konflikte in der SOD-Version in einem</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Matrix-Grid-Layout dargestellt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;SELECTION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U5</TDFORMAT>
       <TDLINE>Umfangsbegrenzung der Matrixausgabe:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>&lt;ZK&gt;&lt;ZH&gt;Hinweis:  Zur angenehmen Betrachtung am Einzelbildschirm wird</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>empfohlen, die Ergebnisse nach mindestens einem Feld zu filtern.&lt;/&gt;&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>SOD-Version: Geben Sie die Nummer der SOD-Matrixversion ein.  Dadurch</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>wird standardmäßig die SOD Version aus der Pflegeanwendung eingestellt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Konflikt-ID:  Geben Sie die SOD-Konflikt-IDs zum Begrenzen der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Matrixausgabe an.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Fkt.-ID:  Geben Sie die Fkt.-IDs zum Begrenzen der Matrixausgabe ein.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Applikationsbereich: Geben Sie den Applikationsbereich des Konflikts zum</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Begrenzen der Matrixausgabe an.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Bntzr-ID Bstzr.: Geben Sie den Verantwortl. der Konflikte zum Begrenzen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der Matrixausgabe an.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>SensitivitEbenen:  Geben Sie eine Sensitivitätsebene des Konfikts zum</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Begrenzen der Matrixausgabe an.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Risikoszenario:  Geben Sie zum Konflikt ein Risikoszenario zum Begrenzen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der Matrixausgabe an.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Vorgeschl. Mitigatn: Geben Sie zum Konflikt eine vorgeschlagene Mitig.</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>zum Begrenzen der Matrixausgabe an.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U5</TDFORMAT>
       <TDLINE>Ausgabeoptionen:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Nach Funktions-/Konflikt-ID</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Nach Beschreibung</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U5</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
