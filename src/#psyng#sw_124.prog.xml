     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>SOD Version Matrix Overview</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>This will display the conflicts in the SOD version in a matrix grid</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>layout.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;SELECTION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U5</TDFORMAT>
       <TDLINE>Restricting Scope of the Matrix Output:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>&lt;ZK&gt;&lt;ZH&gt;NOTE:  For easy viewing on 1 screen, it is recommended to filter</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the results by at least 1 field.&lt;/&gt;&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>SOD Version: Enter the SOD matrix version number.  This will default to</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the SOD Version set in the maintenance application.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Conflict ID:  Specify the SOD Conflict ID(s) to restrict the matrix</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Function ID:  Specify the Function ID(s) to restrict the matrix output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Application Area: Specify the application area of the conflict(s) to</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>restict the matrix output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Owner User ID: Specify the owner of the conflict(s) to restict the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>matrix output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Sensitivity Levels:  Specify a Sensitivity level of the conflict(s) to</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>restict the matrix output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Risk Scenario:  Specify a Risk Scenario for the conflict(s) to restict</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the matrix output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Proposed Mitigation: Specify a Proposed Mitigation for the conflict(s)</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>to restict the matrix output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U5</TDFORMAT>
       <TDLINE>Output Options:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>By Function/Conflict ID</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>By Description</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U5</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
