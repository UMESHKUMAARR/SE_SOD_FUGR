    <item>
     <DOKIL>
      <ID>RE</ID>
      <OBJECT>/PSYNG/CRI_TCODE_LIST_BYROLE</OBJECT>
      <LANGU>E</LANGU>
      <TYP>E</TYP>
      <VERSION>0012</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00065</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/CRI_TCODE_LIST_BYROLE</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00012</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>The purpose of this report is to list users that have critical</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>transactions assigned to them, as defined in the Conflict Repository.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;INTEGRATION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PREREQUISITES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FEATURES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;SELECTION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>Restricting Role Scope</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Role: If you would like to run the analysis for specific roles, select</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the radio button and fill this field with those specific role(s).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Count Roles(push button):  This button can be selected to verify the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>number of roles that will be analyzed from the &quot;Role Restriction&quot;</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>selection criteria entered.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Role Business Area: If you would like to run the analysis for specific</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>role business areas, enter those specific role business areas here. SE</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>will run the analysis for all roles that belong to business areas</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>specified here.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Roles Changed Between: If you would like to run the analysis for</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>specific roles that were recently  created/changed, enter the start and</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>end dates. SW will run the analysis for all roles that were either</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>created or changed between those dates.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>BL</TDFORMAT>
       <TDLINE>This is useful when roles are changed and you want to check whether</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>there were any  Function access in the recently created or changed</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>roles.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Show Roles (push button): You can use this button to display the roles,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>based on the dates specified in &quot;Roles Changed Between&quot; before running</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the analysis.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Analyze Single Roles: Check this checkbox to include single roles in the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>analysis.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Analyze Composite Roles: Check this checkbox to include composite roles</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>in the analysis.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Analyze Assigned Roles Only: Check this checkbox to only include roles</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>that are assigned to users in the analysis.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>Cross System/Remote Options</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Remote System (RFC): If you would like to analyze a role(s) that exists</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>on a different system/client enter the appropriate RFC here.  The</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>role(s) specified will then be analyzed on a system by system basis both</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>locally and on the system(s) dictated by the RFC destination(s) (for all</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>systems where the role(s) exists).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Only on Remote System(s): Used in conjunction with the Remote System</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(RFC) option above to only analyze roles in the remote system(s)</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>specified by the RFC destination(s).  The role(s) will not be analyzed</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>in the local system where the report is being executed.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>Further Restrict the selection by:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Transaction Code(s): Specify transactions code(s) to limit output scope</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Sensitivity:  With this you can restrict the scope of the critical</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>object to specific sensitivity levels that interest you.  If left blank,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the scan will run for all levels.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Owner User ID:  Enter the User ID to restrict the scope of the critical</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>transaction by the owner defined in the SOD version object.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Application Area:  Specify the application area to restrict the scope of</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the critical transaction.  If left blank, the scan will run for all</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>areas.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>SOD Version:  Enter the SOD matrix version to use for the critical</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>tcodes. This will default to the version set in the maintenance</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>application.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>Output Options</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Show Functions in Output:  Fill this checkbox if you would like to</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>display any Function IDs where the transaction code is found in the SOD</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>matrix.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>&lt;ZK&gt;Note, this report is not doing any object level analysis as defined</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>in the Function ID(s), it is only showing a  mapping of the Function</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ID(s) from the matrix where the transaction code is also found.&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Show Roles without Critical Transactions:  Fill this checkbox if you</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>would like to display a message in the output, stating there are no</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Crtitical Transactions found in the roles included in the selection</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>criteria.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;STANDARD_VARIANTS&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U2</TDFORMAT>
       <TDLINE>&amp;OUTPUT&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;ACTIVITIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
