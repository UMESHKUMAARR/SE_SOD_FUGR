      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,o Org. Level Check:Fill this checkbox if you would like to do a</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>conflict analysis including the organization level objects in the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>rules.See section SW Maintain Org Level Values and Appendix for further</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>information.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,o Exclude ER Assigned Roles: This checkbox will show up in the</TDLINE>
