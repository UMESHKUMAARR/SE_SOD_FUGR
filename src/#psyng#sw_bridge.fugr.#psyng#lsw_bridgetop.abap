    obj_or TYPE string,
    fld_and TYPE string,
  END OF ty_res_pbridge_fun_obj,

  BEGIN OF ty_fileupld,
    filename TYPE string,
    content TYPE string,
  END OF ty_fileupld,

  BEGIN OF ty_schema_req,
    api_key TYPE string,
    fileuploads TYPE TABLE OF ty_fileupld WITH NON-UNIQUE DEFAULT KEY,
  END OF ty_schema_req,

  BEGIN OF ty_actions,
    timestamp            TYPE string,
    action               TYPE string,
    targetsystem         TYPE string,
    formatedinstructions TYPE string,
    errormessage         TYPE string,
    callsucceeded         TYPE string,
  END OF ty_actions,

  BEGIN OF ty_schema_res,
    instance TYPE string,
    risks    TYPE TABLE OF string WITH NON-UNIQUE DEFAULT KEY,
    callslog TYPE TABLE OF string WITH NON-UNIQUE DEFAULT KEY,
    actions  TYPE TABLE OF ty_actions WITH NON-UNIQUE DEFAULT KEY,
  END OF ty_schema_res,

  BEGIN OF ty_actvt_grp_req,
    api_key TYPE string,
    fileuploads TYPE TABLE OF ty_fileupld WITH NON-UNIQUE DEFAULT KEY,
  END OF ty_actvt_grp_req,

  BEGIN OF ty_actvt_grp_res,
    instance TYPE string,
