     <DOKIL>
      <ID>TX</ID>
      <OBJECT>/PSYNG/SE_CONFLICT_ORIGIN</OBJECT>
      <LANGU>D</LANGU>
      <TYP>E</TYP>
      <VERSION>0001</VERSION>
      <TXTLINES>00010</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/PSYNG/SE_CONFLICT_ORIGIN</TDNAME>
      <TDID>TX</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Konfliktherkunft</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Mit den Ankreuzfeldern zur Konfliktherkunft wird bestimmt, welche der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>bei der Analyse gefundenen Konflikte angezeigt werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Lokal: Anzeige der Konflikte, die nur durch Berechtigungen im lokalen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>System (in dem die Analyse gestartet wird) verursacht werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Remote: Anzeige der Konflikte, die nur durch Berechtigungen in einem</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Remote-System (in dem nicht die Analyse gestartet wird) verursacht</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Über.: Anzeige der Konflikte, die durch Berechtigungen in mehreren</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Systemen verursacht werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
