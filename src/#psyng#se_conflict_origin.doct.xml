     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Conflict Origin</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>The conflict origin checkboxes determine which of the conflicts that</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>were found in the analysis will be displayed.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Local : Conflicts that are only caused by authorizations in the local</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>system (the system where the analysis is started from) are displayed.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Remote : Conflicts that are only caused by authorizations on a remote</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>system (not the system where the analysis is started from) are</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>displayed.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Cross : Conflicts that are caused by authorizations from multiple</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>systems are displayed.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
